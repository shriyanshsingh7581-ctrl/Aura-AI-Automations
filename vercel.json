{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/avatars/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/portfolio",
      "destination": "/portfolio/index.html"
    },
    {
      "source": "/ai-receptionist",
      "destination": "/ai-receptionist/index.html"
    },
    {
      "source": "/ai-voice-agent",
      "destination": "/ai-voice-agent/index.html"
    },
    {
      "source": "/whatsapp-ai-chatbot",
      "destination": "/whatsapp-ai-chatbot/index.html"
    },
    {
      "source": "/ai-receptionist-for-salon",
      "destination": "/ai-receptionist-for-salon/index.html"
    },
    {
      "source": "/ai-receptionist-for-clinic",
      "destination": "/ai-receptionist-for-clinic/index.html"
    },
    {
      "source": "/((?!assets/|avatars/|sitemap\\.xml|robots\\.txt|og-image\\.png|og-image\\.webp|aura-logo\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
